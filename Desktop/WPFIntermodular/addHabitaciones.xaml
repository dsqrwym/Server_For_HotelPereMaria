<Window x:Class="WPFIntermodular.addHabitaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Room" Height="969" Width="1371" WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Grid>
        <Border CornerRadius="10" Background="#D9D9D9" Width="1000" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="#E5E5E5" BorderThickness="1">
            <Grid>
                <TextBlock Text="Añadir habitación" FontSize="24" FontWeight="Bold" Foreground="#70D890" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>

                <Button Content="X" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="Black" FontSize="14" FontWeight="Bold" BorderBrush="Transparent"/>

                <Grid Margin="0,60,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Nombre" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Huéspedes" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox Height="40">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Descripción" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Height="239" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Seleccionar imagen principal" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Button Content="Seleccionar archivo" HorizontalContentAlignment="Left"    FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Opciones" FontWeight="Bold" Margin="0,0,0,5"/>
                            <CheckBox>Cuna</CheckBox>
                            <CheckBox>Cama extra</CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Precio por noche" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        </StackPanel>


                    </Grid>
                </Grid>

                <Button Content="Enviar" Width="150" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#70D890" Foreground="White" FontWeight="Bold" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
