<Window x:Class="WPFIntermodular.addHabitaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Room" Height="969" Width="1371" WindowStartupLocation="CenterScreen" >


    <Grid>
        <Image x:Name="imageDisplay"></Image>

        <Border CornerRadius="10" Style="{StaticResource Border}" Width="1000" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="#E5E5E5" BorderThickness="1">
            <Grid>
                <Label Style="{StaticResource Titulo}" Content="Añadir habitación"   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>

                <Button Content="X" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="Black" FontSize="14" FontWeight="Bold" BorderBrush="Transparent"/>

                <Grid Margin="0,60,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SubTitle}" Text="Nombre"  Margin="0,0,0,5"/>
                            <TextBox x:Name="nombreText" Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SubTitle}" Text="Huéspedes"  Margin="0,0,0,5"/>
                            <ComboBox x:Name="huespedesCombo" Height="40">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Descripción" Style="{StaticResource SubTitle}"  Margin="0,0,0,5"/>
                        <TextBox x:Name="descripccionText" Height="239" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Seleccionar imagen principal" Style="{StaticResource SubTitle}"  FontWeight="Bold" Margin="0,0,0,5" Width="299" />
                            <Button x:Name="imagen" Content="Seleccionar archivo" HorizontalContentAlignment="Left" Width="302" Click="imagen_Click"     />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Opciones" Style="{StaticResource SubTitle}"  Margin="0,0,0,5" Width="91"/>
                            <CheckBox x:Name="cunaCheck" Width="89">Cuna</CheckBox>
                            <CheckBox x:Name="camaCheck" Width="89">Cama extra</CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Precio por noche"  Style="{StaticResource SubTitle}"  Margin="0,0,0,5" Width="318"/>
                            <TextBlock x:Name="precioText" Text="10" FontWeight="Bold" Margin="0,0,0,5" Width="161" />
                        </StackPanel>


                    </Grid>
                </Grid>

                <Button  Style="{StaticResource BtnPrin}"   x:Name="botonFinal" Width="150" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top"  FontWeight="Bold" Margin="0,488,0,0" Content="Crear" Click="botonFinal_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
