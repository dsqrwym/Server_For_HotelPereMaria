<Window x:Class="WPFIntermodular.vistaUsuario.addUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.vistaUsuario"
        mc:Ignorable="d"
        Title="addUser" Height="300" Width="500">
    <Grid>
        <StackPanel>
            <Label Content="Añadir Usuario" FontWeight="Bold" FontSize="24" Foreground="#FF9933"/>
            <WrapPanel>
                <Label Content="Nombre" Foreground="#026E81"/>
                <Label Content="Apellido" Foreground="#026E81" Margin="100,0,0,0"/>
                <Label Content="Rol" Foreground="#026E81" Margin="100,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="nameField"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="surnameField"/>
                <ComboBox Margin="55,0,0,0" Width="100px" x:Name="roleBox">
                    <ComboBoxItem Name="Admin" Tag="Admin" Content="Admin"/>
                    <ComboBoxItem Name="Empleado" Tag="Empleado" Content="Empleado"/>
                    <ComboBoxItem Name="Cliente" Tag="Cliente" Content="Cliente"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel>
                <Label Content="Email" Foreground="#026E81"/>
                <Label Content="DNI" Foreground="#026E81" Margin="110,0,0,0"/>
                <Label Content="Fecha de Nacimiento" Foreground="#026E81" Margin="130,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="emailField"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="dniField"/>
                <DatePickerTextBox Margin="55,0,0,0" Width="100px" x:Name="birthField" />
            </WrapPanel>
            <WrapPanel>
                <Label Content="Username" Foreground="#026E81"/>
                <Label Content="Telefono" Foreground="#026E81" Margin="85,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="usernameField"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="phoneField"/>
            </WrapPanel>
            <Button Margin="20px" Width="100px" Click="Button_Click">Enviar</Button>
        </StackPanel>
    </Grid>
</Window>
