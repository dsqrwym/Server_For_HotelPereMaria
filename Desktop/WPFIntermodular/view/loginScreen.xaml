<Window x:Class="WPFIntermodular.view.loginScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.view"
        mc:Ignorable="d"
        Title="loginScreen" Height="400" Width="600">
    <Border Style="{StaticResource Border}">
    <Grid>

        <StackPanel HorizontalAlignment="Center">
            <Image Source="/source/hotel.jpg" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200px"/>
                <Label Content="Nombre de Usuario" Style="{StaticResource Titulo}" Margin="0,10,0,0">
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <TextBox Width="200px" Margin="0,2,0,0" BorderBrush="Orange" x:Name="loginUsername">
                <TextBox.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </TextBox.Effect>
            </TextBox>
                <Label Content="Contraseña" Style="{StaticResource Titulo}" Margin="0,10,0,0">
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <TextBox Width="200px" Margin="0,2,0,0" BorderBrush="Orange" x:Name="loginPassword">
                <TextBox.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </TextBox.Effect>
            </TextBox>
                <Button Margin="0,20,0,0" Content="Entrar"  Style="{StaticResource BtnPrin}" x:Name="loginBtn" Click="loginBtn_Click">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
    </Border>
</Window>
