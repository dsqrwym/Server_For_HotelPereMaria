<Window x:Class="WPFIntermodular.view.addUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.view"
        mc:Ignorable="d"
        Title="addUser" Height="300" Width="500">
    <Grid>
        <StackPanel>
            <Label Content="Añadir Usuario" FontWeight="Bold" FontSize="24" Foreground="#FF9933"/>
            <WrapPanel>
                <Label Content="Nombre" Foreground="#026E81"/>
                <Label Content="Apellido" Foreground="#026E81" Margin="100,0,0,0"/>
                <Label Content="Rol" Foreground="#026E81" Margin="100,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="nameField" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="surnameField" Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Margin="55,0,0,0" Width="100px" x:Name="roleBox" SelectedValue="{Binding Rol}">
                    <ComboBoxItem Name="Admin" Tag="Admin" Content="Admin"/>
                    <ComboBoxItem Name="Empleado" Tag="Empleado" Content="Empleado"/>
                    <ComboBoxItem Name="Cliente" Tag="Cliente" Content="Cliente"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel>
                <Label Content="Email" Foreground="#026E81"/>
                <Label Content="DNI" Foreground="#026E81" Margin="110,0,0,0"/>
                <Label Content="Pasword" Foreground="#026E81" Margin="130,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="emailField" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="dniField" Text="{Binding Dni,UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Margin="55,0,0,0" Width="100px" x:Name="passwordBox"  Text="{Binding NotifyOnSourceUpdated,UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>
            <WrapPanel>
                <Label Content="Username" Foreground="#026E81"/>
                <Label Content="Telefono" Foreground="#026E81" Margin="85,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
                <TextBox Margin="5,0,0,0" Width="100px" x:Name="usernameField" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Margin="50,0,0,0" Width="100px" x:Name="phoneField" Text="{Binding Telefono,UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>
            <Button Margin="20px" Width="100px" Command="{Binding EnviarCommand}">Enviar</Button>
        </StackPanel>
    </Grid>
</Window>
