<Window x:Class="WPFIntermodular.view.buscadorHabitaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.viewmodel.habitacionViewModel"
        xmlns:model="clr-namespace:WPFIntermodular.viewmodel.habitacionViewModel"
        d:DataContext="{d:DesignInstance Type=model:buscarHabitacionViewModel}"
        mc:Ignorable="d"
        Title="Buscador" Height="700" Width="1440">

    <Border Style="{StaticResource Fondo}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de Filtros -->
            <StackPanel Grid.Column="0" Margin="20">
                <Border Style="{StaticResource Border}" Padding="10" CornerRadius="15" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Button Content="←" FontSize="20" Background="Transparent" HorizontalContentAlignment="Left" />

                        <Label FontSize="20">ID habitación</Label>
                        <TextBox Name="idText" Height="24" Width="244" HorizontalAlignment="Left"
                                 Text="{Binding FiltroId, UpdateSourceTrigger=PropertyChanged}" />

                        <Label FontSize="20">Nombre</Label>
                        <TextBox Name="NameText" Height="24" Width="244" HorizontalAlignment="Left"
                                 Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}" />

                        <Label FontSize="20">Tipo</Label>
                        <ComboBox ItemsSource="{Binding TiposHabitacion}"  
          SelectedIndex="{Binding SelectedTipoIndex, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,0">
                            <Button Style="{DynamicResource BtnSec}" Width="124" Height="37" Margin="0,0,10,0">Ofertas</Button>
                            <Button Style="{StaticResource BtnPrin}" Width="139">Buscar</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tabla de Habitaciones -->
            <StackPanel Grid.Column="1" Margin="20">
                <DataGrid Name="listaHab" AutoGenerateColumns="False" Width="582" Margin="0,0,0,10"
                          SelectionChanged="listaHab_SelectionChanged"
                          ItemsSource="{Binding Habitaciones}"
                          SelectedItem="{Binding HabitacionSeleccionada, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="80" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripccion}" Width="150" />
                        <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Width="409">
                    <Button Name="btnBorrar" Style="{StaticResource BtnPrin}" Width="188" Height="49" 
                            Click="borrarClick" Content="Borrar" Margin="10"/>
                    <Button Name="buscarEditBtn" Style="{StaticResource BtnPrin}" Width="188" Height="49" 
                            Command="{Binding BuscarEditCommand}" Click="buscarEditBtn_Click" Margin="10"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
