<Window x:Class="WPFIntermodular.view.buscadorHabitaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.viewmodel.habitacionViewModel"
        mc:Ignorable="d"
        Title="Buscador" Height="700" Width="1440">
    <Window.DataContext>
        <local:buscarHabitacionViewModel />
    </Window.DataContext>

    <Border Style="{StaticResource Fondo}">
    <Grid  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20">
            <Border Style="{StaticResource Border}" Padding="10" CornerRadius="15" VerticalAlignment="Stretch">
                <StackPanel>
                        <Button Content="←" FontSize="20" Background="Transparent" HorizontalContentAlignment="Left" Click="Button_Click_1" ></Button>

                        <Label FontSize="20">ID habitacion</Label>
                    <TextBox Name ="idText" Height="24" Width="244" HorizontalAlignment="Left"></TextBox>

                    <Label FontSize="20">Tipo</Label>
                    <ComboBox Name="tiposCombo" Height="24" Width="244" HorizontalAlignment="Left">
                        <ComboBoxItem>Individual</ComboBoxItem>
                        <ComboBoxItem>Estandar</ComboBoxItem>
                        <ComboBoxItem>Lujo</ComboBoxItem>
                        <ComboBoxItem>Suite</ComboBoxItem>
                        <ComboBoxItem>Duplex</ComboBoxItem>
                    </ComboBox>




                    <Label FontSize="20" Margin="10,10,0,0">¿Ocupada?</Label>
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <RadioButton FontSize="20" GroupName="si/no" FontFamily="Montserrat" Margin="0,0,10,0" Name="ocupadaSi">Sí</RadioButton>
                        <RadioButton FontSize="20" GroupName="si/no" FontFamily="Montserrat" Name="ocupadaNo">No</RadioButton>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,0">
                            <Button Style="{DynamicResource BtnSec}" Width="124" Height="37" Margin="0,0,10,0">Ofertas</Button>
                        <Button Style="{StaticResource BtnPrin}"  Width="139"  Click="Button_Click" >Buscar</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20">
            <ListView Name="listaHab" Width="582" Margin="0,0,0,10" SelectionChanged="listaHab_SelectionChanged" ItemsSource="{Binding Habitaciones}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="80" />
                        <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Tipo}" Width="150" />
                        <GridViewColumn Header="Capacidad" DisplayMemberBinding="{Binding Capacidad}" Width="100" />


                        </GridView>
                </ListView.View>
            </ListView>
                <Button Name="buscarEditBtn"  Style="{StaticResource BtnPrin}" Width="188" Height="49" Click="buscarEditBtn_Click"></Button>
        </StackPanel>

    </Grid>
    </Border>
</Window>