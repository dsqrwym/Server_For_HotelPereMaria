<Window x:Class="WPFIntermodular.vistaUsuario.userList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.vistaUsuario"
        mc:Ignorable="d"
        Title="userList" Height="450" Width="800">
    <Grid Background="#32586d">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="600"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70px"/>
            <RowDefinition Height="380"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#32586d" Margin="0,0,0,1">
            <Image Source="/source/hotel.jpg" Height="62"/>
            <Label FontSize="30px" FontWeight="Bold" Foreground="Orange" Content="Hotel Pere Maria" >
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Button x:Name="userBtn" Content="Usuario" FontSize="30px" Background="Transparent" BorderBrush="Transparent" Margin="650,-50,0,0" Height="44" Width="117" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Button.Effect>
            </Button>
        </WrapPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Background="#32586d">

            <Label Content="FILTROS" Foreground="Orange" FontSize="15px" Margin="10,10,10,0" RenderTransformOrigin="0.545,0.805" Height="32">
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Label Content="ROL" Foreground="Orange" FontSize="15px" Margin="10,0,0,0" RenderTransformOrigin="0.545,0.805" Height="32">
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <ComboBox x:Name="FiltroRolComboBox" Width="150"
                SelectionChanged="FiltroRolComboBox_SelectionChanged" Background="#32586d" Foreground="Orange">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#32586d"/>
                        <Setter Property="Foreground" Value="Orange"/>
                    </Style>
                </ComboBox.Resources>
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Cliente"/>
                <ComboBoxItem Content="Empleado"/>
            </ComboBox>
            <Label Content="ID" Foreground="Orange" FontSize="15px" Margin="10,0,0,0" RenderTransformOrigin="0.545,0.805" Height="32">
                <Label.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Label.Effect>
            </Label>
            <TextBox x:Name="filterByID" VerticalAlignment="Center" Width="100px" Margin="0,0,0,0" TextChanged="filterByID_TextChanged"/>

            <Button x:Name="detallesBtn" Content="Ver Detalles" Width="100px" Click="detallesBtn_Click" Margin="0,10,0,10" Background="#32586d" Foreground="Orange">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Button.Effect>
            </Button>

            <Button x:Name="updateBtn" Content="Modificar Usuario" Width="100px" Background="#32586d" Foreground="Orange" Click="updateBtn_Click">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Button.Effect>
            </Button>

            <Button x:Name="anyadirBtn" Content="Añadir Usuario" Width="100px" Margin="10px" Background="#32586d" Foreground="Orange" Click="anyadirBtn_Click">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3" Opacity="1"/>
                </Button.Effect>
            </Button>
        </StackPanel>

        <ListView x:Name="UserListView" Margin="20,50,50,50" BorderThickness="2px" Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="Orange">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50"
                            DisplayMemberBinding="{Binding id}" />
                    <GridViewColumn Header="NombreUsuario" Width="140"
                            DisplayMemberBinding="{Binding nombre}" />
                    <GridViewColumn Header="Rol" Width="160"
                            DisplayMemberBinding="{Binding rol}" />
                    <GridViewColumn Header="DNI" Width="208"
                            DisplayMemberBinding="{Binding dni}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
