<Window x:Class="WPFIntermodular.view.CrearReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.view"
        mc:Ignorable="d"
        Title="CrearReserva"  Height="1018" Width="1440" Background="{StaticResource Fondo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="18*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="160*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>

        <!-- Body -->
        <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="311*"/>
                <ColumnDefinition Width="730*"/>
                <ColumnDefinition Width="179*"/>
            </Grid.ColumnDefinitions>

            <!--Habitacion Info-->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                <!--Crear Reserva-->
                <TextBlock x:Name="titulo" ClipToBounds="False" Foreground="{StaticResource azulNormal}" FontSize="40" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Crear Reserva"/>

                <!--Image de Habitacion-->
                <Image x:Name="imageHabitacion" Source="/source/habitacion.png" Margin="23 46 23 20"/>

                <!--Nombre de Habitacion-->
                <TextBlock x:Name="nombreHabitacion" Foreground="{StaticResource azulClick}" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Habitación" AllowDrop="True"/>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <!--Fecha de Entrada-->
                    <StackPanel Margin="20 10">
                        <Label Margin="10 5" Content="_Fecha de entrada" Target="{Binding ElementName=fechaEntradaInput}"/>
                        <DatePicker x:Name="fechaEntradaInput" Style="{StaticResource DatePickerStyle}" SelectedDateChanged="fechaEntradaInput_SelectedDateChanged" IsEnabled="False"/>
                    </StackPanel>

                    <!--Fecha de salida-->
                    <StackPanel Margin="20 10">
                        <Label Margin="10 5" Content="_Fecha de salida" Target="{Binding ElementName=fechaSalidaInput}"/>
                        <DatePicker x:Name="fechaSalidaInput" Style="{StaticResource DatePickerStyle}" SelectedDateChanged="fechaSalidaInput_SelectedDateChanged" IsEnabled="False"/>
                    </StackPanel>

                    <!--Huespedes-->
                    <StackPanel Margin="20 10">
                        <StackPanel Orientation="Horizontal">
                            <Label VerticalAlignment="Center" Content="_Huespedes: " Target="{Binding ElementName=cantidadHuespedes}"/>
                            <TextBlock Margin="10" Text="{Binding ElementName=cantidadHuespedes, Path=Value}" />
                        </StackPanel>
                        <Slider x:Name="cantidadHuespedes" Minimum="1" IsSnapToTickEnabled="True" KeyDown="cantidadHuespedes_KeyDown"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20 10">
                    <!--Listas extras, si no hay servicio extras, cambiar visibility a collapse-->
                    <StackPanel x:Name="contenedorListaExtras">
                        <Label Content="_Seleccione servicios adicionales" Margin="10" Target="{Binding ElementName=extrasList}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="100" Width="200">
                            <ItemsControl x:Name="extrasList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="10" Content="{Binding Nombre}" Tag="{Binding Precio}" Checked="CheckBox_UpdatePrice" Unchecked="CheckBox_UpdatePrice"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!--Precio total-->
                    <Canvas Margin="50 10 0 10">
                        <TextBlock Canvas.Top="0" Canvas.Left="0" Text="Precio"/>
                        <TextBlock Canvas.Bottom="10" Canvas.Left="0" x:Name="precioTotal" Margin="0 30 0 0" Foreground="#00ABBD" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" Height="50"/>
                    </Canvas>
                </StackPanel>

                <!--Sellecionar Cliente-->
                <StackPanel Grid.Row="2" Margin="20" Width="300" HorizontalAlignment="Left">
                    <Label Content="_Cliente" Margin="10 10 10 0" Target="{Binding ElementName=clienteComboBox}"/>
                    <ComboBox x:Name="clienteComboBox" 
                              Margin="10" Style="{StaticResource ComboBoxStyle}" 
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" 
                              SelectionChanged="clienteComboBox_SelectionChanged"
                              IsEditable="True" IsTextSearchEnabled="False"
                              KeyUp="clienteComboBox_KeyUp"
                              />

                    <TextBlock Margin="10 30 0 0">
                        <Run x:Name="clienteNombre" Text="nombre"/>
                        <Run Text="    -   "/>
                        <Run x:Name="clienteEmail" Text="email"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!--Operaciones-->
            <Canvas Grid.Column="2">
                <!--Cancelar-->
                <Button Canvas.Top="30" Canvas.Right="0" Style="{StaticResource cicleButton}" Click="Button_CloseClick">
                    <TextBlock Text="✖️" FontSize="26" Foreground="White"/>
                </Button>

                <Button x:Name="crearNuevaReserva" Canvas.Bottom="5" Canvas.Right="0" Content="Crear Reserva" 
                        FontSize="20" Height="46" 
                        Width="180" 
                        Style="{StaticResource RoundButtonStyle}" Click="crearNuevaReserva_Click"
                     />
            </Canvas>
        </Grid>
    </Grid>
</Window>
