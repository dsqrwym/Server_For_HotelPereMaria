<Window x:Class="WPFIntermodular.vistaUsuario.updateUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFIntermodular.vistaUsuario"
        mc:Ignorable="d"
        Title="updateUser" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ID:" Grid.Row="0"/>
        <TextBox x:Name="IDTextBox" Grid.Row="0" Margin="80,0,0,5" IsReadOnly="True"/>

        <TextBlock Text="Nombre:" Grid.Row="1"/>
        <TextBox x:Name="NombreTextBox" Grid.Row="1" Margin="80,0,0,5"/>

        <TextBlock Text="Rol:" Grid.Row="2"/>
        <ComboBox x:Name="RolComboBox" Grid.Row="2" Margin="80,0,0,5" Width="200">
            <ComboBoxItem Content="Administrador"/>
            <ComboBoxItem Content="Cliente"/>
            <ComboBoxItem Content="Invitado"/>
        </ComboBox>

        <TextBlock Text="DNI:" Grid.Row="3"/>
        <TextBox x:Name="DNITextBox" Grid.Row="3" Margin="80,0,0,5"/>

        <TextBlock Text="Email:" Grid.Row="4"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="4" Margin="80,0,0,5"/>

        <TextBlock Text="Fecha Nac.:" Grid.Row="5"/>
        <TextBox x:Name="FechaNacTextBox" Grid.Row="5" Margin="80,0,0,5"/>

        <Button Content="Guardar Cambios" Grid.Row="6" Margin="80,10,0,0" Width="150"
                Click="GuardarCambios_Click"/>
    </Grid>
</Window>

